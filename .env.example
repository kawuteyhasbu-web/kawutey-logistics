# Copy this file to .env locally. Never commit real credentials.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5500
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5500/payment-return.html
ADMIN_NAME=Kawutey Logistics Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Administrator signup email notifications (SMTP). Keep these values private.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Road-routing service base URL. The default public OSRM demo endpoint is for development/testing only.
# Select a reliable provider and review its terms/limits before production use.
ROUTING_SERVICE_URL=https://router.project-osrm.org
